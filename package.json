{
  "name": "diorama",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "description": "Diorama — a living model of your Home Assistant home. Spatial design + live state visualization + device control.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "tsc -b && DIORAMA_DEPLOY=1 vite build",
    "deploy:watch": "DIORAMA_DEPLOY=1 vite build --watch"
  },
  "dependencies": {
    "lit": "^3.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/three": "^0.184.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.11"
  }
}
