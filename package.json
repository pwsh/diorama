{
  "name": "diorama",
  "private": true,
  "version": "0.25.0",
  "type": "module",
  "description": "Diorama — a living model of your Home Assistant home. Spatial design + live state visualization + device control.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "tsc -b && DIORAMA_DEPLOY=1 vite build",
    "deploy:watch": "DIORAMA_DEPLOY=1 vite build --watch",
    "docs:gallery": "node scripts/docs-gallery/generate.mjs",
    "docs:site": "node scripts/docs-site/build.mjs",
    "docs:floorplans": "node scripts/docs-site/floorplans.mjs",
    "floorplans:build": "node scripts/floorplans/build.mjs",
    "docs:publish": "node scripts/docs-gallery/publish.mjs"
  },
  "dependencies": {
    "lit": "^3.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/three": "^0.184.0",
    "esbuild": "^0.28.1",
    "gifenc": "^1.0.3",
    "typescript": "^5.6.0",
    "vite": "^8.0.11"
  }
}
